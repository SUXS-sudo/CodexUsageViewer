<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>CodexUsageViewer</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="CodexUsageViewer.Resources.Strings.en-US.txt" />
    <None Remove="CodexUsageViewer.Resources.Strings.zh-CN.txt" />
    <EmbeddedResource Include="CodexUsageViewer.Resources.Strings.en-US.txt" LogicalName="CodexUsageViewer.Resources.Strings.en-US.txt" />
    <EmbeddedResource Include="CodexUsageViewer.Resources.Strings.zh-CN.txt" LogicalName="CodexUsageViewer.Resources.Strings.zh-CN.txt" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
